<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <!-- Один дочерний элемент: вертикальный LinearLayout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Счётчик -->
        <TextView
            android:id="@+id/tvCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:text="0"
            android:textSize="72sp"
            android:textStyle="bold"
            android:textColor="#FF5722" />

        <!-- Информация об улучшениях -->
        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="+1 за клик | 0 в секунду"
            android:textSize="16sp"
            android:textColor="#666666" />

        <!-- Главная кнопка клика -->
        <Button
            android:id="@+id/btnClick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:text="НАЖМИ МЕНЯ!"
            android:textSize="20sp" />

        <!-- ===== Улучшения ===== -->

        <!-- 1. Сила клика -->
        <Button
            android:id="@+id/btnUpgradeClick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Сила клика (10)"
            android:textSize="14sp" />

        <!-- 2. Автоклик -->
        <Button
            android:id="@+id/btnUpgradeAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Автоклик (50)"
            android:textSize="14sp" />

        <!-- 3. Критический клик -->
        <Button
            android:id="@+id/btnUpgradeCrit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Крит. клик 20% x5 (100)"
            android:textSize="14sp" />

        <!-- 4. Мега-клик -->
        <Button
            android:id="@+id/btnUpgradeMega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Мега-клик +5 (200)"
            android:textSize="14sp" />

        <!-- 5. Турбо-автоклик -->
        <Button
            android:id="@+id/btnUpgradeTurbo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Турбо-авто +5/сек (500)"
            android:textSize="14sp" />

        <!-- 6. Золотой клик -->
        <Button
            android:id="@+id/btnUpgradeGold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Золотой клик x10 (1000)"
            android:textSize="14sp" />

        <!-- Кнопка сброса -->
        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#B0BEC5"
            android:text="Сбросить прогресс"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
